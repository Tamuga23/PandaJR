rules_version = '2';

// Desplegadas el 2026-09-30 (reemplazan el modo de prueba que caducaba el 2026-10-23).
// Desplegar cambios: npx firebase-tools deploy --only firestore:rules (proyecto en .firebaserc).
// Probar antes en el emulador: firebase emulators:start --only firestore
//
// Modelo de datos (src/lib/firebase/pairing.ts):
//   users/{uid}                          { role, pregnancyId, updatedAt }
//   invite_codes/{code}                  { pregnancyId, createdBy, createdAt, expiresAt, usedBy, usedAt,
//                                          revokedAt?, babyName?, momName?, week?, dueDate?, legacy? }
//   pregnancies/{pid}                    { babyName, momName?, week?, createdBy, inviteCode, inviteExpiresAt,
//                                          dueDate? ('aaaa-mm-dd'), dueDateSource? ('eco'|'fum'|'manual'),
//                                          dueDateUpdatedAt?, dueDateUpdatedBy?, dueDateUpdatedByName?,
//                                          members: { [uid]: { role: 'mama'|'papa', name?, joinedAt, viaCode? } } }
//   pregnancies/{pid}/shared_data/*      events, kick_sessions, contractions, budget, birth_plan,
//                                        checklist_progress (items, meta, owners, ownersMeta),
//                                        care_team, prep_{eventId}, baby_names (antiguo)
//                                        care_team = { obName, obPhone, hospitalName, hospitalAddress,
//                                          emergencyNumber, country, crisisLine, updatedAt } (R2 · paso 4:
//                                          country y crisisLine; shared_data no filtra campos, así que
//                                          no hace falta cambiar ninguna regla)
//   pregnancies/{pid}/baby_names/{id}    { name, ..., votes: { [uid]: 'like'|'nope' } }
//   pregnancies/{pid}/nudges/{id}        { fromUid, fromName, fromRole, kind, createdAt }
//   pregnancies/{pid}/status_logs|journal|tasks|gobag/{id}
//
// ORDEN DE DESPLIEGUE (importante):
//   1. Publicar la versión de la app que llama a ensureMembership() al abrir con pregnancyId.
//      Eso añade `members` a los embarazos antiguos y, si la mamá tiene un código antiguo
//      (PANDA-XXXX) y aún no hay copiloto, le emite uno nuevo PANDA-XXXX-XXXX. Los códigos de
//      4 caracteres nunca se copian a invite_codes (se adivinan por fuerza bruta: 32^4 ≈ 1 millón).
//   2. Esperar a que los teléfonos de las parejas existentes abran la app al menos una vez.
//   3. Recién entonces desplegar estas reglas. Un embarazo que siga sin `members` queda
//      inaccesible (ver bloque TRANSICIÓN más abajo si se necesita un periodo de gracia).
//
// Nota: con Auth anónimo, borrar los datos del navegador crea un uid nuevo. Ese teléfono deja de
// ser miembro y necesita un código nuevo (la mamá lo genera; ella puede quitar el uid viejo).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Utilidades ----------

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function membersOf(data) {
      return data.get('members', {});
    }

    function isMemberIn(data) {
      return signedIn() && membersOf(data).keys().hasAny([me()]);
    }

    function roleIn(data) {
      return membersOf(data).get(me(), {}).get('role', '');
    }

    function pregnancyData(pid) {
      return get(/databases/$(database)/documents/pregnancies/$(pid)).data;
    }

    // Para subcolecciones y para invite_codes (una lectura del documento del embarazo por petición).
    function isMember(pid) {
      return signedIn() && isMemberIn(pregnancyData(pid));
    }

    function isMama(pid) {
      return signedIn() && roleIn(pregnancyData(pid)) == 'mama';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function membersDiff() {
      return membersOf(request.resource.data).diff(membersOf(resource.data));
    }

    // Código de invitación canjeado por quien hace la petición y vigente (se evalúa tras la transacción).
    // Solo el formato nuevo (32^8 combinaciones) es canjeable.
    function isNewInviteCode(c) {
      return c is string && c.matches('^PANDA-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$');
    }

    function inviteValidFor(inv, pid) {
      return inv.pregnancyId == pid
        && inv.usedBy == me()
        && inv.get('revokedAt', null) == null
        && inv.expiresAt > request.time;
    }

    // ---------- users ----------

    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;
    }

    // ---------- invite_codes ----------

    match /invite_codes/{code} {
      // Cualquier usuario autenticado puede leer un código concreto (vista previa antes de unirse).
      // Contiene solo pregnancyId, nombres para mostrar y fechas. Nunca listar.
      allow get: if signedIn();
      allow list: if false;

      // Crear: solo la mamá del embarazo, formato nuevo, sin usar y con caducidad de 15 días o menos.
      allow create: if signedIn()
        && code.matches('^PANDA-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$')
        && request.resource.data.createdBy == me()
        && isMama(request.resource.data.pregnancyId)
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null
        && !('revokedAt' in request.resource.data)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'd');

      allow update: if signedIn() && (
        // Canjear: marcar usedBy con el propio uid si no está usado por otro, ni caducado, ni revocado.
        // Nunca un código antiguo de 4 caracteres, aunque exista un documento con ese id.
        (
          isNewInviteCode(code)
          && (resource.data.usedBy == null || resource.data.usedBy == me())
          && resource.data.createdBy != me()
          && resource.data.get('revokedAt', null) == null
          && resource.data.expiresAt > request.time
          && changedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == me()
        )
        ||
        // Revocar: la mamá (al regenerar o al quitar a alguien) o quien lo canjeó (al salirse).
        (
          changedKeys().hasOnly(['revokedAt'])
          && (isMama(resource.data.pregnancyId) || resource.data.usedBy == me())
        )
      );

      allow delete: if false;
    }

    // ---------- pregnancies ----------

    // Unirse con un código de invite_codes (solo formato nuevo PANDA-XXXX-XXXX).
    function joiningWithInvite(pid) {
      let entry = membersOf(request.resource.data).get(me(), {});
      return changedKeys().hasOnly(['members'])
        && membersDiff().affectedKeys().hasOnly([me()])
        && entry.get('role', '') == 'papa'
        && isNewInviteCode(entry.get('viaCode', null))
        && inviteValidFor(getAfter(/databases/$(database)/documents/invite_codes/$(entry.viaCode)).data, pid);
    }

    // Actualizar la propia entrada (p. ej. el nombre) sin cambiar de rol.
    function editingOwnEntry() {
      let before = membersOf(resource.data).get(me(), null);
      let after = membersOf(request.resource.data).get(me(), null);
      return before != null
        && after != null
        && changedKeys().hasOnly(['members'])
        && membersDiff().affectedKeys().hasOnly([me()])
        && after.get('role', '') == before.get('role', '');
    }

    // Quitar a un miembro: la mamá a otra persona, o el copiloto a sí mismo.
    function removingMember() {
      let d = membersDiff();
      return changedKeys().hasOnly(['members'])
        && d.addedKeys().size() == 0
        && d.changedKeys().size() == 0
        && d.removedKeys().size() == 1
        && (
          (roleIn(resource.data) == 'mama' && !d.removedKeys().hasAny([me()]))
          || (roleIn(resource.data) == 'papa' && d.removedKeys().hasOnly([me()]))
        );
    }

    // LEGACY (RETIRADO): ya no existe una regla para unirse con el código antiguo PANDA-XXXX
    // guardado en el propio embarazo. Con 32^4 ≈ 1 millón de combinaciones se adivina por fuerza
    // bruta y daría acceso a datos de salud. Las parejas antiguas que ya estaban unidas siguen
    // entrando por `members` (ensureMembership); quien aún no se unió necesita el código nuevo que
    // la app le emite a la mamá.

    match /pregnancies/{pid} {
      allow get: if isMemberIn(resource.data);

      // FALLBACK LEGACY (DESACTIVADO): joinPregnancyAsDad/previewInvite todavía hacen
      //   query(pregnancies, where('inviteCode', '==', 'PANDA-XXXX'), limit(2))
      // para códigos antiguos. Con `list` prohibido esa consulta falla con permission-denied y la
      // app lo muestra como "Ese código caducó. Pídele a tu pareja uno nuevo". Permitir `list` expone
      // TODOS los embarazos a cualquier usuario autenticado (las reglas no pueden obligar a que
      // la consulta filtre por inviteCode con un valor concreto): bastaría con listar de 2 en 2.
      // Si hiciera falta un periodo de gracia, activar SOLO temporalmente y con fecha límite:
      //   allow list: if signedIn() && request.query.limit <= 2
      //                && request.time < timestamp.date(2026, 11, 15);
      allow list: if false;

      // Crear: quien crea es la mamá y el único miembro inicial.
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && membersOf(request.resource.data).keys().hasOnly([me()])
        && membersOf(request.resource.data).get(me(), {}).get('role', '') == 'mama';

      allow update: if signedIn() && (
        // Datos generales (semana, nombre del bebé...): cualquier miembro, sin tocar miembros ni código.
        (isMemberIn(resource.data)
          && !changedKeys().hasAny(['members', 'createdBy', 'inviteCode', 'inviteExpiresAt', 'inviteCodeUpdatedAt']))
        // Regenerar el código: solo la mamá.
        || (roleIn(resource.data) == 'mama'
          && changedKeys().hasOnly(['inviteCode', 'inviteExpiresAt', 'inviteCodeUpdatedAt']))
        || joiningWithInvite(pid)
        || editingOwnEntry()
        || removingMember()
        // TRANSICIÓN (DESACTIVADA): permitir que un usuario se añada a sí mismo a un embarazo antiguo
        // sin `members` si users/{uid}.pregnancyId apunta a él. Es inseguro (cada quien puede editar
        // su propio users/{uid}), así que solo con fecha límite corta:
        // || (request.time < timestamp.date(2026, 11, 15)
        //     && !('members' in resource.data)
        //     && changedKeys().hasOnly(['members'])
        //     && membersOf(request.resource.data).keys().hasOnly([me()])
        //     && get(/databases/$(database)/documents/users/$(me())).data.pregnancyId == pid)
      );

      allow delete: if false;

      // Nombres: cada quien solo puede escribir su propio voto.
      match /baby_names/{nameId} {
        allow read: if isMember(pid);
        allow create: if isMember(pid) && request.resource.data.get('votes', {}).size() == 0;
        allow delete: if isMember(pid);
        allow update: if isMember(pid) && (
          (changedKeys().hasOnly(['votes', 'updatedAt'])
            && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([me()]))
          || !changedKeys().hasAny(['votes'])
        );
      }

      // Abrazos: se firman con el propio uid y no se editan.
      match /nudges/{nudgeId} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && request.resource.data.fromUid == me()
          && request.resource.data.kind == 'hug';
        allow update: if false;
        allow delete: if isMember(pid) && resource.data.fromUid == me();
      }

      // Resto de subcolecciones (shared_data, status_logs, journal, tasks, gobag): solo miembros.
      // Pendiente de endurecer: status_logs solo la mamá; journal borrar solo autor (authorUid,
      // que las entradas antiguas no tienen).
      match /{sub}/{docId} {
        allow read, write: if isMember(pid) && !(sub in ['baby_names', 'nudges']);
      }
    }
  }
}
